+import { acknowledgeHandoff, readHandoff, receiverState, writeReceiverHandoff } from "../state/inbound-handoff-store.js";
+import { withAccountLock } from "../state/lock.js";
+
+function validate({ stateDir, accountId, ownerUserId, ids }, requireIds = true) {
+  if (!stateDir || typeof accountId !== "string" || !/^[a-zA-Z0-9._@-]+$/.test(accountId) ||
+      typeof ownerUserId !== "string" || !ownerUserId || (requireIds && (!Array.isArray(ids) ||
+      !ids.length || !ids.every(id => typeof id === "string" && id) || new Set(ids).size !== ids.length))) {
+    throw new TypeError("Receiver requires stateDir, accountId, ownerUserId and unique non-empty string IDs");
+  }
+}
+
+// This is the existing hook consumer's local acceptance boundary, not another
+// fetcher. Copy trusted staged messages, never caller-supplied message bodies.
+export async function receiveInbound(options = {}) {
+  validate(options);
+  const { stateDir, accountId, ownerUserId, ids } = options;
+  const result = await withAccountLock(stateDir, accountId, async () => {
+    const doc = await readHandoff(stateDir, accountId);
+    const receiver = receiverState(doc, ownerUserId);
+    const processed = new Set(receiver.processedIds);
+    const staged = new Map(doc.pending.map(m => [m.id, m]));
+    const pending = new Map(receiver.pending.map(m => [m.id, m]));
+    // Validate the entire batch before changing anything; IDs are exact and
+    // account-scoped. Equal text/timestamps on different IDs are independent.
+    for (const id of ids) {
+      const source = staged.get(id) ?? pending.get(id);
+      if (source && source.fromUserId !== ownerUserId) throw new TypeError("Inbound receiver owner mismatch");
+      if (!source && !processed.has(id)) throw new TypeError("Unknown inbound message ID");
+      if (!processed.has(id)) pending.set(id, source);
+    }
+    receiver.pending = [...pending.values()];
+    await writeReceiverHandoff(stateDir, accountId, { ...doc, receiver });
+    return { accountId, messages: ids.filter(id => !processed.has(id)).map(id => pending.get(id)),
+      duplicateCount: ids.filter(id => processed.has(id)).length };
+  });
+  // Deliberately outside the first lock: call the existing inbox ack primitive
+  // only AFTER receiver work is durable. Failure leaves resumable work.
+  await acknowledgeHandoff(stateDir, accountId, ids);
+  return result;
+}
+
+// Invoke only after this ID's business handling has completed. An unfinished
+// record is replayable; acceptance alone must never mark an ID as processed.
+export async function completeInbound(options = {}) {
+  validate(options);
+  const { stateDir, accountId, ownerUserId, ids } = options;
+  return withAccountLock(stateDir, accountId, async () => {
+    const doc = await readHandoff(stateDir, accountId);
+    const receiver = receiverState(doc, ownerUserId);
+    const processed = new Set(receiver.processedIds);
+    const pending = new Set(receiver.pending.map(m => m.id));
+    for (const id of ids) {
+      if (!pending.has(id) && !processed.has(id)) throw new TypeError("Inbound message was not received");
+      processed.add(id);
+    }
+    const done = new Set(ids);
+    receiver.pending = receiver.pending.filter(m => !done.has(m.id));
+    receiver.processedIds = [...processed];
+    await writeReceiverHandoff(stateDir, accountId, { ...doc, receiver });
+    return { completed: ids.length };
+  });
+}
+
+// Operator-only rollback, with the hook paused and active workers drained.
+// Preserve both ID ledgers and return unfinished accepted work to legacy fetch.
+export async function requeueInbound(options = {}) {
+  validate(options, false);
+  const { stateDir, accountId, ownerUserId } = options;
+  return withAccountLock(stateDir, accountId, async () => {
+    const doc = await readHandoff(stateDir, accountId);
+    const receiver = receiverState(doc, ownerUserId);
+    const pending = new Map(doc.pending.map(m => [m.id, m]));
+    for (const message of receiver.pending) pending.set(message.id, message);
+    const requeued = receiver.pending.length;
+    receiver.pending = [];
+    await writeReceiverHandoff(stateDir, accountId, { ...doc, pending: [...pending.values()], receiver });
+    return { requeued };
+  });
+}
