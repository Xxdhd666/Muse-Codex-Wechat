+import { createHash } from "node:crypto";
+import { open, stat } from "node:fs/promises";
+import path from "node:path";
+import { accountStatePath } from "../state/state-dir.js";
+import { readJsonFile, writeJsonAtomic } from "../state/json-file.js";
+import { withAccountLock } from "../state/lock.js";
+import { appendMessageHistory } from "../state/message-history.js";
+import { generateClientId } from "./ilink-client.js";
+import { WxbError } from "./errors.js";
+
+const hash = text => createHash("sha256").update(text).digest("hex");
+export const segmentedFile = (state, account) => accountStatePath(state, account, ".segmented-send.ledger");
+export async function segmentedEnabled(state) {
+  try { return (await stat(path.join(state, "segmented-retry.enabled"))).isFile(); }
+  catch (e) { if (e.code === "ENOENT") return false; throw e; }
+}
+
+// All journal operations, including reports, run under the existing account lock.
+async function readJournal(state, account) {
+  const doc = await readJsonFile(segmentedFile(state, account), { version: 1, items: {} });
+  if (doc?.version !== 1 || !doc.items || typeof doc.items !== "object" || Array.isArray(doc.items) ||
+      !Object.values(doc.items).every(r => r && typeof r.userId === "string" &&
+        typeof r.textHash === "string" && Array.isArray(r.chunks) && r.chunks.length > 0 &&
+        r.chunks.every(c => typeof c.text === "string" && typeof c.clientId === "string" &&
+          ["pending", "inflight", "confirmed"].includes(c.state)) &&
+        ["active", "unknown", "delivered"].includes(r.state) &&
+        hash(r.chunks.map(c => c.text).join("")) === r.textHash &&
+        (r.state !== "delivered" || r.chunks.every(c => c.state === "confirmed")))) {
+    throw new WxbError("SEGMENTED_JOURNAL_INVALID", "Segment journal unreadable; manual review required.");
+  }
+  return doc;
+}
+async function persist(state, account, doc) {
+  const file = segmentedFile(state, account);
+  await writeJsonAtomic(file, doc);
+  const dir = await open(path.dirname(file), "r");
+  try { await dir.sync(); } finally { await dir.close(); }
+}
+function view(id, r, reason = r.reason, enabled = true) {
+  const confirmedChunks = [], unknownChunks = [], pendingChunks = [];
+  r.chunks.forEach((c, i) => (c.state === "confirmed" ? confirmedChunks :
+    c.state === "inflight" ? unknownChunks : pendingChunks).push(i + 1));
+  const deliveryStatus = !enabled && r.state === "active" && !confirmedChunks.length ? "unknown" : r.state === "delivered" ? "delivered" :
+    r.state === "unknown" || unknownChunks.length ? "unknown" :
+      confirmedChunks.length ? "partial" : "queued";
+  return { deliveryStatus, delivered: deliveryStatus === "delivered", queued: deliveryStatus === "queued",
+    deliveryId: id, toUserId: r.userId, textHash: r.textHash, chunkCount: r.chunks.length,
+    confirmedChunks, unknownChunks, pendingChunks,
+    sent: r.chunks.flatMap((c, i) => c.state === "confirmed" ?
+      [{ clientId: c.clientId, chunkIndex: i + 1, chars: c.text.length }] : []),
+    ...(!enabled && r.state === "active" ? { retryPaused: true, reason: "SEGMENTED_RETRY_DISABLED" } : {}),
+    ...(r.reportedAt ? { reportAcknowledged: true } : {}),
+    ...(reason ? { reason } : {}), requiresConfirmation: deliveryStatus === "unknown" };
+}
+
+// No server idempotency is assumed. Only explicit protocol rejection proves
+// non-delivery; network/timeout/5xx/invalid JSON and arbitrary errors are unknown.
+const rejected = e => e instanceof WxbError &&
+  ["INVALID_CONTEXT_TOKEN", "SESSION_EXPIRED", "AUTH_FAILED"].includes(e.code);
+
+export async function segmentedSession({ stateDir, account, userId, text, chunks, deliveryId }) {
+  const enabled = await segmentedEnabled(stateDir);
+  const doc = await readJournal(stateDir, account.accountId);
+  const id = hash(`${userId}\0${deliveryId ?? text}`);
+  let r = doc.items[id];
+  if (r && (r.userId !== userId || r.textHash !== hash(text))) {
+    throw new WxbError("DELIVERY_ID_CONFLICT", "Delivery ID belongs to different content.");
+  }
+  if (!enabled && !r) return null; // exact legacy path for unenrolled messages
+  const response = (reason) => ({ accountId: account.accountId, ...view(id, r, reason, enabled) });
+  if (r && (r.state !== "active" || r.chunks.some(c => c.state === "inflight"))) {
+    return { result: response() }; // includes interrupted in-flight write-ahead
+  }
+  // Disabling never hands an enrolled partial message back to whole-text retry.
+  if (!enabled && r) return { result: { ...response("SEGMENTED_RETRY_DISABLED"), retryPaused: true } };
+  if (!r) {
+    r = { userId, textHash: hash(text), createdAt: new Date().toISOString(), state: "active",
+      chunks: chunks.map(text => ({ text, clientId: generateClientId(), state: "pending" })) };
+    doc.items[id] = r;
+  }
+  return {
+    async send({ client, contextToken, timeoutMs }) {
+      for (let i = 0; i < r.chunks.length; i++) {
+        const c = r.chunks[i];
+        if (c.state === "confirmed") continue;
+        c.state = "inflight";
+        // Failure here means NO send begins. A possibly committed marker is
+        // deliberately left in-flight for conservative recovery.
+        try { await persist(stateDir, account.accountId, doc); }
+        catch { return { ...response("PROGRESS_WRITE_FAILED_BEFORE_SEND"), deliveryStatus: "unknown",
+          delivered: false, queued: false, requiresConfirmation: true }; }
+        try {
+          await client.sendTextMessage({ token: account.token, toUserId: userId,
+            text: c.text, contextToken, clientId: c.clientId, timeoutMs });
+        } catch (e) {
+          if (rejected(e)) { c.state = "pending"; r.reason = e.code; }
+          else { r.state = "unknown"; r.reason = "SEND_RESPONSE_UNKNOWN"; }
+          try { await persist(stateDir, account.accountId, doc); }
+          catch { c.state = "inflight"; r.state = "unknown"; r.reason = "PROGRESS_WRITE_FAILED"; }
+          return response();
+        }
+        try {
+          await appendMessageHistory(stateDir, account.accountId, { id: c.clientId,
+            direction: "outgoing", fromUserId: account.ownerUserId, toUserId: userId,
+            timestamp: Math.floor(Date.now() / 1000), type: "text", text: c.text,
+            contextToken, chunkIndex: i + 1, chunkCount: r.chunks.length, segmentedDeliveryId: id });
+        } catch {
+          r.state = "unknown"; r.reason = "OUTGOING_HISTORY_WRITE_FAILED";
+          try { await persist(stateDir, account.accountId, doc); } catch { /* durable in-flight marker remains */ }
+          return response();
+        }
+        c.state = "confirmed";
+        if (r.chunks.every(c => c.state === "confirmed")) r.state = "delivered";
+        delete r.reason;
+        try { await persist(stateDir, account.accountId, doc); }
+        catch {
+          c.state = "inflight"; r.state = "unknown"; r.reason = "PROGRESS_WRITE_FAILED_AFTER_SEND";
+          try { await persist(stateDir, account.accountId, doc); } catch { /* keep earlier write-ahead */ }
+          return response();
+        }
+      }
+      return response();
+    }
+  };
+}
+
+export async function segmentedReports(stateDir, accountId) {
+  return withAccountLock(stateDir, accountId, async () => {
+    const doc = await readJournal(stateDir, accountId);
+    const enabled = await segmentedEnabled(stateDir);
+    return { items: Object.entries(doc.items).flatMap(([id, r]) => {
+      const item = view(id, r, undefined, enabled);
+      return item.deliveryStatus === "unknown" && !r.reportedAt
+        ? [{ accountId, ...item }] : [];
+    }), reportProtocol: "仅在主对话报告 deliveryId、textHash 与 confirmedChunks/unknownChunks/pendingChunks；待确认项禁止全文重发、禁止写入 outbox。实际报告后调用 queue send-report-ack --account <accountId> --ids <已报告 deliveryId 的 JSON 数组>。只确认报告事实，不解除发送暂停。未报告不得 ack。人工核对后另行决定。" };
+  });
+}
+
+export async function acknowledgeSegmentReports(stateDir, accountId, ids) {
+  if (!Array.isArray(ids) || !ids.every(id => typeof id === "string" && /^[a-f0-9]{64}$/.test(id))) {
+    throw new TypeError("Expected segment delivery IDs");
+  }
+  return withAccountLock(stateDir, accountId, async () => {
+    const doc = await readJournal(stateDir, accountId);
+    const enabled = await segmentedEnabled(stateDir);
+    for (const id of ids) {
+      const r = doc.items[id];
+      if (!r || view(id, r, undefined, enabled).deliveryStatus !== "unknown") throw new TypeError("Not a paused delivery");
+      r.reportedAt = new Date().toISOString();
+    }
+    await persist(stateDir, accountId, doc);
+    return { acknowledged: ids.length, retryPaused: true };
+  });
+}
+
+// Snapshot decoration only: it does not change queue/void/expiry semantics.
+export async function segmentedQueueProgress(stateDir, accountId, items) {
+  const doc = await readJournal(stateDir, accountId);
+  const enabled = await segmentedEnabled(stateDir);
+  return items.map(item => {
+    const id = hash(`${item.userId}\0${item.deliveryId ?? item.text}`);
+    const r = doc.items[id];
+    return r ? { ...item, segmented: view(id, r, undefined, enabled) } : item;
+  });
+}
