+#!/usr/bin/env python3
+"""只解析发送结果文件；不加载账号、不联网、不输出正文或凭据。"""
+import json, sys
+
+def classify(envelope, rc=0):
+    if not isinstance(envelope, dict):
+        return 'unknown'
+    d = envelope.get('data')
+    if isinstance(d, dict) and d.get('voided') is True:
+        return 'voided'
+    if isinstance(d, dict) and 'deliveryStatus' in d:
+        status = d['deliveryStatus']
+        if envelope.get('ok') is not True or rc != 0:
+            return 'unknown'
+        if status not in ('delivered', 'queued', 'partial', 'unknown', 'failed'):
+            return 'unknown'
+        if status == 'delivered' and (d.get('delivered') is not True or d.get('queued') is True):
+            return 'unknown'
+        if status == 'queued' and (d.get('queued') is not True or d.get('delivered') is True):
+            return 'unknown'
+        if status in ('partial', 'unknown') and (d.get('delivered') is True or d.get('queued') is True):
+            return 'unknown'
+        return status
+    if isinstance(d, dict) and d.get('voided') is True:
+        return 'voided'
+    if rc != 0 or envelope.get('ok') is not True:
+        details = envelope.get('error', {}).get('details', {})
+        if (details.get('sentCount', 0) or details.get('delivered') is True or details.get('deliveredClientIds')):
+            return 'unknown'
+        return 'failed'
+    if not isinstance(d, dict):
+        return 'unknown'
+    if d.get('queued') is True:
+        return 'queued'
+    count, sent = d.get('chunkCount'), d.get('sent')
+    return 'delivered' if type(count) is int and count >= 1 and isinstance(sent, list) and len(sent) == count else 'unknown'
+
+if __name__ == '__main__':
+    try:
+        with open(sys.argv[1], encoding='utf-8') as f:
+            result = classify(json.load(f), int(sys.argv[2]) if len(sys.argv) > 2 else 0)
+    except (OSError, ValueError, TypeError, AttributeError, IndexError):
+        result = 'unknown'
+    print(result)
